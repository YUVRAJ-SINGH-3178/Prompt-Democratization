# ==============================================================================
# Prompt Repository Lab: Environment Configuration Example
# Copy to .env and fill in your API keys as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq API Configuration (OpenAI-compatible)
# ------------------------------------------------------------------------------
# Paste your Groq API key below (starts with gsk_...)
GROQ_API_KEY=

# Default Groq model (e.g. openai/gpt-oss-20b, or llama-3.3-70b-versatile if enabled in your org)
GROQ_MODEL=openai/gpt-oss-20b

# Groq OpenAI-compatible endpoint
GROQ_API_BASE=https://api.groq.com/openai/v1/chat/completions


# ------------------------------------------------------------------------------
# Generic Study / Extractor Settings (Optional)
# ------------------------------------------------------------------------------
# If STUDY_API_KEY is left empty, the application falls back to GROQ_API_KEY or OPENAI_API_KEY.
# STUDY_API_KEY=
# STUDY_MODEL=
# STUDY_API_BASE=

# ------------------------------------------------------------------------------
# Router & Cold Start Parameters (Optional)
# ------------------------------------------------------------------------------
# ROUTER_MIN_RATINGS=
# ROUTER_STD_THRESHOLD=0.25
